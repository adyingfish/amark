{
  "name": "amark",
  "version": "0.2.0",
  "private": true,
  "description": "Local Markdown workspace for reading and editing agent output",
  "homepage": "https://github.com/adyingfish/amark",
  "author": "AMark contributors",
  "main": "out/main/main.js",
  "scripts": {
    "prepare": "lefthook install",
    "desktop:dev": "electron-vite dev --watch",
    "desktop:start": "vp run desktop:build && electron-vite preview --skipBuild",
    "desktop:pack": "vp run desktop:build && electron-builder --dir",
    "desktop:dist": "vp run desktop:build && electron-builder",
    "desktop:test": "tsc -p tsconfig.electron.json && node --test electron/*.test.cjs",
    "desktop:build": "tsc --noEmit -p tsconfig.electron.json && electron-vite build"
  },
  "dependencies": {
    "chokidar": "4.0.3"
  },
  "devDependencies": {
    "@milkdown/kit": "^7.19.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "hyphen": "^1.14.1",
    "jsdom": "^29.1.1",
    "katex": "^0.17.0",
    "lefthook": "^2.1.9",
    "lucide-react": "^1.21.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mermaid": "^11.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.0",
    "unified": "^11.0.5",
    "vite-plus": "0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4"
  },
  "packageManager": "bun@1.4.0",
  "desktopName": "amark.desktop"
}
